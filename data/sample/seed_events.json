 },
 {
  "id": 3,
  "type": "EmailReceived",
  "payload": {
   "message_id": "order-clearview-001@clearview-glazing.example",
   "sender": "g.lloyd@clearview-glazing.example",
   "subject": "Riverside Court facade package - order confirmed",
   "sent_at": "2026-09-01T09:45:00+01:00",
   "body": "Sarah,\n\nGood to speak earlier. As discussed, we've confirmed both parts of the facade\npackage:\n\nPO-24130 - 140 no. unitised curtain wall panels\nPO-24131 - 96 no. aluminium double glazed windows\n\nBoth are due on site 3 March 2027. Our install team will follow the frame.\n\nGareth Lloyd\nClearview Glazing Systems",
   "channel": "email"
  },
  "created_at": "2026-10-13T00:30:50.974531Z",
  "caused_by": null,
