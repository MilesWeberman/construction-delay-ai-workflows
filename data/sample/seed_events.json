  "payload": {
   "message_id": "update-003@pennine-steel.example",
   "sender": "orders@pennine-steel.example",
   "subject": "RE: PO-24110 Riverside Court - steel delivery",
   "sent_at": "2026-10-12T09:14:00+01:00",
   "body": "Hi Sarah,\n\nUnfortunately our mill has pushed back the rolling of the UC sections for your\njob. We can no longer make the 29th December delivery for PO-24110.\n\nEarliest we can now get the columns and beams to site is Tuesday 12th January\n2027. We'll confirm the exact load sequence nearer the time.\n\nApologies for the knock-on, give me a call if you want to talk options.\n\nRegards,\nMark Bentley\nPennine Steel Fabrications Ltd",
   "channel": "email"
  },
  "created_at": "2026-10-13T00:22:46.971367Z",
  "caused_by": null,
  "status": "done",
  "error": null,
  "dedupe_key": "email:update-003@pennine-steel.example"
 },
