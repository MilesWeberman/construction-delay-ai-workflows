  "type": "EmailReceived",
  "payload": {
   "message_id": "order-northgate-001@northgate-supplies.example",
   "sender": "orders@northgate-supplies.example",
   "subject": "Order acknowledgements - Riverside Court, Leeds",
   "sent_at": "2026-08-24T10:03:00+01:00",
   "body": "Hello Sarah,\n\nThank you for your orders. Please find acknowledgements below. All deliveries\nto Riverside Court site, Kirkstall Road, Leeds.\n\nPO-24101  Precast concrete piles 300x300      120 nr    deliver 11/11/2026\nPO-24103  Rebar and mesh (pile caps/beams)     42 t     deliver 02/12/2026\nPO-24120  Roof membrane + insulation boards   650 m2    deliver 17/03/2027\nPO-24150  Plasterboard and metal studs       4200 m2    deliver 19/05/2027\nPO-24190  Block paving and landscaping         1 lot    deliver 31/03/2027\nPO-24171  Sanitaryware (bathrooms)             60 sets  deliver 16/06/2027\nPO-24180  LVT floor finishes                 3100 m2    deliver 14/07/2027\n\nPlease give 48 hours notice for any changes to delivery dates.\n\nNorthgate Building Supplies",
   "channel": "email"
  },
  "created_at": "2026-10-13T00:22:46.965783Z",
  "caused_by": null,
  "status": "done",
  "error": null,
  "dedupe_key": "email:order-northgate-001@northgate-supplies.example"
 },
 {
  "id": 2,
  "type": "EmailReceived",
  "payload": {
   "message_id": "order-pennine-001@pennine-steel.example",
   "sender": "orders@pennine-steel.example",
   "subject": "Order confirmation PO-24110 / PO-24111 Riverside Court",
   "sent_at": "2026-08-27T15:20:00+01:00",
   "body": "Hi Sarah,\n\nConfirming we've booked the following against your orders:\n\n- PO-24110: structural steel frame (columns and beams), approx 310 t.\n  Delivery to site Tuesday 29th December 2026, ready for erection in the new\n  year.\n- PO-24111: composite metal decking for floors L1-L5, 2,600 m2. Delivery\n  27th January 2027.\n\nRegards,\nMark Bentley\nPennine Steel Fabrications Ltd",
   "channel": "email"
  },
  "created_at": "2026-10-13T00:22:46.966611Z",
