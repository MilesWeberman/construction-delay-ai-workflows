  "type": "RecoveryOptionsProposed",
  "payload": {
   "assessment_event": 47,
   "po_number": "PO-24110",
   "options": [
    {
     "title": "Accelerate the internal fit-out trades to absorb the delay later in the programme",
     "edits": [
      {
       "type": "shorten",
       "activity_id": "A12",
       "predecessor_id": null,
       "days": 5,
       "po_number": null,
       "new_delivery": null,
       "not_before": null
      },
      {
       "type": "shorten",
       "activity_id": "A13",
       "predecessor_id": null,
       "days": 4,
       "po_number": null,
       "new_delivery": null,
       "not_before": null
      },
      {
       "type": "shorten",
       "activity_id": "A16",
       "predecessor_id": null,
       "days": 4,
       "po_number": null,
       "new_delivery": null,
       "not_before": null
      },
      {
       "type": "shorten",
       "activity_id": "A17",
       "predecessor_id": null,
       "days": 3,
       "po_number": null,
       "new_delivery": null,
       "not_before": null
      }
     ],
     "rationale": "MEP first fix, drylining, kitchen/bathroom fit-out and decoration are all critical and all labour-driven, so each can be trimmed by extra gangs or overtime without touching the frame or envelope risk. Spreading the acceleration across several trades keeps any single crew's uplift within the usual 30% crashing limit and avoids concentrating risk on the steel package, which is already under pressure from the late delivery.",
     "risks": "Running several trades harder in parallel increases coordination and quality risk (snagging, rework) and depends on enough extra operatives being available across multiple subcontractors at the same time; drylining and M&E first fix must not be rushed to the point of compromising inspection and sign-off.",
     "cost": "Extra gangs/overtime across four trades, roughly \u00a350k-\u00a365k in total, likely a variation if the delay is supplier-caused.",
     "recovered_days": 16,
     "new_finish": "2027-08-10"
    },
    {
     "title": "Crash steel erection and decking to claw back time on the primary critical path",
     "edits": [
      {
       "type": "shorten",
       "activity_id": "A05",
       "predecessor_id": null,
       "days": 4,
       "po_number": null,
       "new_delivery": null,
       "not_before": null
      },
      {
       "type": "shorten",
       "activity_id": "A06",
       "predecessor_id": null,
       "days": 5,
       "po_number": null,
       "new_delivery": null,
       "not_before": null
      }
     ],
     "rationale": "A05 (steel erection) and A06 (decking/floor slabs) are both critical and immediately follow the late steel delivery. Adding a second erection gang and running decking on longer shifts/weekends compresses these labour-driven activities directly on the critical path, which is the most direct way to recover the lost days without touching downstream trades.",
     "risks": "Steel erectors and riggers are specialist crews; a second gang may not be available at short notice and tower crane time is shared, so lifts may need careful re-sequencing. Any change to erection sequence must be re-checked against temporary works and edge protection under CDM 2015 before it goes on site.",
     "cost": "One additional steel erection gang plus weekend/longer shifts for decking, roughly \u00a335k-\u00a345k depending on overtime rates and crane hire extension.",
     "recovered_days": 9,
     "new_finish": "2027-08-19"
    },
    {
     "title": "Fast-track curtain walling behind the steel frame instead of waiting for full completion",
     "edits": [
      {
       "type": "remove_dependency",
       "activity_id": "A09",
       "predecessor_id": "A06",
       "days": null,
       "po_number": null,
       "new_delivery": null,
       "not_before": null
      }
     ],
     "rationale": "Curtain walling can follow the frame floor by floor rather than waiting for all of A06 (decking/upper floor slabs) to finish. Dropping the dependency lets the glazing crew mobilise on the lower floors as soon as those floor plates are safe to load, overlapping two currently sequential critical activities and pulling the watertight milestone forward.",
     "risks": "This needs tight coordination between the decking and curtain wall crews sharing the same crane and floor edges; temporary edge protection must be in place before glazing starts on any floor, and the sequence must be signed off as safe under CDM 2015 before site teams act on it. If floor-by-floor handover slips, the gain can evaporate.",
     "cost": "Mainly coordination and possibly a second mast climber/MEWP for the glazing crew to work independently of the decking gang, roughly \u00a310k-\u00a315k.",
     "recovered_days": 9,
     "new_finish": "2027-08-19"
    }
   ],
   "rejected": []
